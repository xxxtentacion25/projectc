text = input("Enter text: ")
rails = int(input("Enter rails: "))
# Encryption
cipher = ""
cycle = 2 * (rails - 1)
for r in range(rails):
    for i in range(len(text)):
        x = i % cycle
        if x == r or x == cycle - r:
            cipher += text[i]
print("Encrypted:", cipher)
# Decryption
pattern = []
for i in range(len(text)):
    x = i % cycle
    pattern.append(x if x < rails else cycle - x)
counts = [pattern.count(r) for r in range(rails)]
rail = []
start = 0
for c in counts:
    rail.append(cipher[start:start+c])
    start += c
pos = [0] * rails
plain = ""
for r in pattern:
    plain += rail[r][pos[r]]
    pos[r] += 1
print("Decrypted:", plain)
